Output docs/demo.gif

Set Shell zsh
Set FontSize 16
Set Width 900
Set Height 500
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms

Type "echo 'xbridge — build iOS from any machine on your network'"
Enter
Sleep 1s

Type "xbridge --help"
Enter
Sleep 3s

Type "echo 'On the Mac: start the server'"
Enter
Sleep 500ms

Type "xbridge serve --help"
Enter
Sleep 3s

Type "echo 'On Linux: configure remote and build'"
Enter
Sleep 500ms

Type "xbridge remote set mac:7900 --key my-secret"
Enter
Sleep 1s

Type "xbridge build --help"
Enter
Sleep 3s

Type "echo 'Manage simulators remotely'"
Enter
Sleep 500ms

Type "xbridge sim --help"
Enter
Sleep 2s

Type "echo 'The killer combo: pull, build, install, launch'"
Enter
Sleep 500ms

Type "xbridge run --help"
Enter
Sleep 3s

Type "echo 'Screenshots, deep links, log streaming — all via curl too'"
Enter
Sleep 500ms

Type "echo 'curl http://mac:7900/health'"
Enter
Sleep 500ms

Type "echo 'curl http://mac:7900/simulators/BOOTED/screenshot > screen.png'"
Enter
Sleep 2s

Type "echo 'Zero config. One binary. Both sides.'"
Enter
Sleep 3s
